# Copy this file to .env and fill it in. Never upload .env to GitHub.

# true  = emails are only saved in data/outbox (safe for testing)
# false = emails are really sent through Gmail
EMAIL_DRY_RUN=true

# Your Gmail address and a Gmail App Password (NOT your normal password).
# Create one: Google Account > Security > 2-Step Verification > App passwords
SMTP_USER=yourname@gmail.com
SMTP_APP_PASSWORD=abcdabcdabcdabcd

# Shown to websites when collecting jobs, so they can contact you
CONTACT_EMAIL=yourname@gmail.com
